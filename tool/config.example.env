# Clip tool settings. install.sh copies this file to config.env once and never
# overwrites it afterwards. Every line is optional: leave a value empty to use
# the default shown in the comment.

# Where finished clips are saved. Default: the `output` folder inside the tool.
CLIP_TOOL_OUT_DIR=

# Speech-to-text model. small.en is the default (English, about 460 MB, downloaded
# once on first use). Use `small` for other languages, `medium.en` or `medium`
# for higher accuracy at roughly four times the processing time, `tiny.en` for speed.
CLIP_TOOL_WHISPER_MODEL=small.en

# Background music. A file name inside the music folder, or a full path.
# Empty means clips are rendered with no music.
CLIP_TOOL_DEFAULT_MUSIC=
CLIP_TOOL_MUSIC_VOLUME=0.07

# How many browser tabs render frames at once. 2 is safe on an 8 GB Mac.
CLIP_TOOL_REMOTION_CONCURRENCY=2

# ---- Optional: automatic clip picking without Claude Code in the loop ----
# Not needed for normal use (Claude Code reads the transcript and picks clips).
# Only pick_clips.py uses these. Never share this file once a key is in it.
ANTHROPIC_API_KEY=
CLIP_TOOL_ANTHROPIC_MODEL=claude-opus-5-5
# Name used in the clip picker's instructions, for example your own name.
CLIP_TOOL_CREATOR_NAME=

# ---- Optional: Google Drive download and upload ----
# Folder holding google_credentials.json (your own OAuth client) and the token
# the tool saves after you sign in. Default: ~/.config/clip-tool/google
CLIP_TOOL_GOOGLE_DIR=
# Id of the Drive folder that finished clips are uploaded to (a `Done` subfolder
# is created inside it). The id is the last part of the folder's web address.
CLIP_TOOL_OUTPUT_FOLDER=
